// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DegreeType {
  BACHELOR
  MASTER
  PHD
  DIPLOMA
  ASSOCIATE
  CERTIFICATE
  FOUNDATION
}

enum ConsultationStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  CLOSED
}

enum Region {
  EUROPE
  AMERICAS
  OCEANIA
  ASIA
  AFRICA
}

enum ScholarshipType {
  FULL_FUNDING
  PARTIAL
  MERIT_BASED
}

enum ConsultationType {
  ONLINE
  IN_PERSON
}

// ─────────────────────────────────────────────────────────────────────────────
// Country — powers Study Destinations listing/detail + comparison tool
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id                    String   @id @default(cuid())
  name                  String   @unique
  slug                  String   @unique
  region                Region
  cardImageUrl          String?  @map("card_image_url")
  heroImageUrl          String?  @map("hero_image_url")
  shortDescription      String?  @map("short_description")
  tagline               String?
  // Translated prose. Null until translated for that locale — the read path
  // falls back to the English `tagline` when so. Th/My: Thai, Burmese. Vi, Fil
  // and Idn: Vietnamese, Filipino, Indonesian (Idn rather than Id, which would
  // read as a foreign key; the locale code itself is still `id`).
  taglineTh             String?  @map("tagline_th")
  taglineMy             String?  @map("tagline_my")
  taglineVi              String?  @map("tagline_vi")
  taglineFil             String?  @map("tagline_fil")
  taglineIdn             String?  @map("tagline_idn")
  overview              String?  @db.Text
  // Translated prose. Null until a country's overview has been translated for
  // that locale — the read path falls back to `overview` (English) when so.
  overviewTh            String?  @map("overview_th") @db.Text
  overviewMy            String?  @map("overview_my") @db.Text
  overviewVi             String?  @map("overview_vi") @db.Text
  overviewFil            String?  @map("overview_fil") @db.Text
  overviewIdn            String?  @map("overview_idn") @db.Text

  // Key Stats
  institutionCount      String?  @map("institution_count")
  tuitionFeeRange       String?  @map("tuition_fee_range")
  postStudyWorkVisa     String?  @map("post_study_work_visa")
  studentSatisfaction   Float?   @map("student_satisfaction")
  internationalStudents Float?   @map("international_students")
  graduateEmployability Float?   @map("graduate_employability")

  // Immigration & Costs
  visaProcessingTime    String?  @map("visa_processing_time")
  workRights            String?  @map("work_rights")
  // Translated work-rights text. Null until translated for that locale; the read
  // path falls back to the English `workRights` when so. Idn is Indonesian (the
  // locale code is `id`; the column suffix avoids reading as a foreign key).
  workRightsTh          String?  @map("work_rights_th")
  workRightsMy          String?  @map("work_rights_my")
  workRightsVi          String?  @map("work_rights_vi")
  workRightsFil         String?  @map("work_rights_fil")
  workRightsIdn         String?  @map("work_rights_idn")
  costOfLivingMinUSD    Int?     @map("cost_of_living_min_usd")
  costOfLivingMaxUSD    Int?     @map("cost_of_living_max_usd")
  currencyCode          String?  @map("currency_code")

  // Academic specialties as simple string array
  academicSpecialties   String[] @map("academic_specialties")

  isFeatured            Boolean  @default(false) @map("is_featured")
  isPublished           Boolean  @default(true)  @map("is_published")

  universities          University[]
  advantages            CountryAdvantage[]
  processSteps          CountryProcessStep[]
  faqs                  CountryFAQ[]

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt      @map("updated_at")

  @@index([region])
  @@index([isFeatured])
  @@index([slug])
  @@map("countries")
}

// ─────────────────────────────────────────────────────────────────────────────
// CountryAdvantage — "Why Study Here" cards on destination detail page
// ─────────────────────────────────────────────────────────────────────────────

model CountryAdvantage {
  id            String  @id @default(cuid())
  title         String
  description   String? @db.Text
  // Translated prose. Null until translated for that locale — the read path
  // falls back to the English `title`/`description` when so.
  titleTh       String? @map("title_th")
  titleMy       String? @map("title_my")
  titleVi        String?  @map("title_vi")
  titleFil       String?  @map("title_fil")
  titleIdn       String?  @map("title_idn")
  descriptionTh String? @map("description_th") @db.Text
  descriptionMy String? @map("description_my") @db.Text
  descriptionVi  String?  @map("description_vi") @db.Text
  descriptionFil String?  @map("description_fil") @db.Text
  descriptionIdn String?  @map("description_idn") @db.Text
  imageUrl      String? @map("image_url")
  order         Int     @default(0)

  countryId     String  @map("country_id")
  country       Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@index([countryId])
  @@map("country_advantages")
}

// ─────────────────────────────────────────────────────────────────────────────
// CountryProcessStep — "Journey Ahead" steps on destination detail page
// ─────────────────────────────────────────────────────────────────────────────

model CountryProcessStep {
  id            String  @id @default(cuid())
  stepNumber    Int     @map("step_number")
  title         String
  description   String? @db.Text
  // Translated prose. Null until translated for that locale — the read path
  // falls back to the English `title`/`description` when so.
  titleTh       String? @map("title_th")
  titleMy       String? @map("title_my")
  titleVi        String?  @map("title_vi")
  titleFil       String?  @map("title_fil")
  titleIdn       String?  @map("title_idn")
  descriptionTh String? @map("description_th") @db.Text
  descriptionMy String? @map("description_my") @db.Text
  descriptionVi  String?  @map("description_vi") @db.Text
  descriptionFil String?  @map("description_fil") @db.Text
  descriptionIdn String?  @map("description_idn") @db.Text

  countryId     String  @map("country_id")
  country       Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  @@unique([countryId, stepNumber])
  @@index([countryId])
  @@map("country_process_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// CountryFAQ — "Common Questions" on destination detail page
// ─────────────────────────────────────────────────────────────────────────────

model CountryFAQ {
  id          String  @id @default(cuid())
  question    String
  answer      String  @db.Text
  // Translated prose. Null until translated for that locale — the read path
  // falls back to the English `question`/`answer` when so.
  questionTh  String? @map("question_th")
  questionMy  String? @map("question_my")
  questionVi   String?  @map("question_vi")
  questionFil  String?  @map("question_fil")
  questionIdn  String?  @map("question_idn")
  answerTh    String? @map("answer_th") @db.Text
  answerMy    String? @map("answer_my") @db.Text
  answerVi     String?  @map("answer_vi") @db.Text
  answerFil    String?  @map("answer_fil") @db.Text
  answerIdn    String?  @map("answer_idn") @db.Text
  order       Int     @default(0)

  countryId   String  @map("country_id")
  country     Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([countryId])
  @@map("country_faqs")
}

// ─────────────────────────────────────────────────────────────────────────────
// University — central model for finder, detail, comparison tool
// ─────────────────────────────────────────────────────────────────────────────

model University {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?  @map("logo_url")
  coverImageUrl         String?  @map("cover_image_url")
  shortDescription      String?  @map("short_description")
  overview              String?  @db.Text
  city                  String?
  foundedYear           Int?     @map("founded_year")

  // Key Metrics
  ranking               Int?
  totalStudents         Int?     @map("total_students")
  numberOfCampuses      Int?     @map("number_of_campuses")
  acceptanceRate        Float?   @map("acceptance_rate")
  graduateEmployability Float?   @map("graduate_employability")
  internationalStudents Float?   @map("international_students")
  intakeMonths          String?  @map("intake_months")

  // Tuition & Costs
  tuitionFeeMin         Int?     @map("tuition_fee_min")
  tuitionFeeMax         Int?     @map("tuition_fee_max")
  tuitionCurrency       String?  @map("tuition_currency")

  // Study Options
  hasOnCampus           Boolean  @default(true)  @map("has_on_campus")
  hasOnline             Boolean  @default(false) @map("has_online")
  hasHybrid             Boolean  @default(false) @map("has_hybrid")

  isFeatured            Boolean  @default(false) @map("is_featured")
  isPublished           Boolean  @default(true)  @map("is_published")

  countryId             String   @map("country_id")
  country               Country  @relation(fields: [countryId], references: [id])
  programs              Program[]
  scholarships          Scholarship[]
  admissionSteps        AdmissionStep[]

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt      @map("updated_at")

  @@index([countryId])
  @@index([ranking])
  @@index([slug])
  @@index([isFeatured])
  @@index([tuitionFeeMin, tuitionFeeMax])
  @@map("universities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Program — degree/course offered by a university
// ─────────────────────────────────────────────────────────────────────────────

model Program {
  id                String     @id @default(cuid())
  name              String
  slug              String
  degreeLevel       DegreeType @map("degree_level")
  field             String
  applicationFee    String?    @map("application_fee")
  tuitionFeePerYear String?    @map("tuition_fee_per_year")
  durationYears     Float?     @map("duration_years")
  description       String?

  universityId      String     @map("university_id")
  university        University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt      @map("updated_at")

  @@unique([universityId, slug])
  @@index([universityId])
  @@index([degreeLevel])
  @@index([field])
  @@map("programs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Scholarship — university-level only (country-level scholarships removed)
// ─────────────────────────────────────────────────────────────────────────────

model Scholarship {
  id           String          @id @default(cuid())
  name         String
  type         ScholarshipType
  description  String?         @db.Text
  value        String?
  learnMoreUrl String?         @map("learn_more_url")

  universityId String?         @map("university_id")
  university   University?     @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt      @map("updated_at")

  @@index([universityId])
  @@index([type])
  @@map("scholarships")
}

// ─────────────────────────────────────────────────────────────────────────────
// AdmissionStep — university-specific application steps
// ─────────────────────────────────────────────────────────────────────────────

model AdmissionStep {
  id           String     @id @default(cuid())
  stepNumber   Int        @map("step_number")
  title        String
  description  String?    @db.Text

  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  @@unique([universityId, stepNumber])
  @@index([universityId])
  @@map("admission_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consultation — booking form submissions
// ─────────────────────────────────────────────────────────────────────────────

model Consultation {
  id               String              @id @default(cuid())
  fullName         String              @map("full_name")
  email            String
  phone            String?
  targetCountry    String?             @map("target_country")
  consultationType ConsultationType?   @map("consultation_type")
  message          String?             @db.Text
  source           String?             @default("website")
  status           ConsultationStatus  @default(NEW)

  // Whether the lead reached the Firmli CRM: "synced", "failed" or "skipped"
  // (Firmli not configured). Null for leads saved before this was tracked.
  crmStatus        String?             @map("crm_status")
  crmError         String?             @map("crm_error") @db.Text
  crmSyncedAt      DateTime?           @map("crm_synced_at")

  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt      @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([crmStatus])
  @@map("consultations")
}

// ─────────────────────────────────────────────────────────────────────────────
// CareerLead — Career Discovery Assessment submissions (lead generation)
// ─────────────────────────────────────────────────────────────────────────────

model CareerLead {
  id                      String             @id @default(cuid())
  fullName                String             @map("full_name")
  email                   String
  phone                   String?
  educationLevel          String?            @map("education_level")
  preferredCountry        String?            @map("preferred_country")

  hollandCode             String             @map("holland_code")
  riasecScores            Json               @map("riasec_scores")
  bigFiveScores           Json               @map("big_five_scores")
  recommendedFields       Json               @map("recommended_fields")
  recommendedUniversities Json               @map("recommended_universities")
  rawAnswers              Json               @map("raw_answers")
  aiBrief                 String?            @map("ai_brief") @db.Text

  status                  ConsultationStatus @default(NEW)
  source                  String?            @default("career-discovery")

  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt      @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("career_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// AssessmentLead — combined assessment (Interests + Personality + Aptitude)
// ─────────────────────────────────────────────────────────────────────────────

model AssessmentLead {
  id                      String             @id @default(cuid())
  fullName                String             @map("full_name")
  email                   String
  phone                   String?
  educationLevel          String?            @map("education_level")
  preferredCountry        String?            @map("preferred_country")

  hollandCode             String             @map("holland_code")
  riasecScores            Json               @map("riasec_scores")
  bigFiveScores           Json               @map("big_five_scores")
  aptitudeScores          Json               @map("aptitude_scores")
  aptitudeOverall         Int                @map("aptitude_overall")
  recommendedFields       Json               @map("recommended_fields")
  recommendedUniversities Json               @map("recommended_universities")
  rawAnswers              Json               @map("raw_answers")
  aiBrief                 String?            @map("ai_brief") @db.Text

  status                  ConsultationStatus @default(NEW)
  source                  String?            @default("assessment")

  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt      @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("assessment_leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// ChatConversation — UNTOUCHED
// ─────────────────────────────────────────────────────────────────────────────

model ChatConversation {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  locale        String   @default("en")
  messageCount  Int      @default(0)
  ledToConsult  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sessionId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User / Account / Session — Auth.js v5 — UNTOUCHED
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
